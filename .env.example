# Supabase (プロジェクト設定 > API から取得)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (模試生成・記述採点・通知文生成)
ANTHROPIC_API_KEY=

# Resend (保護者への日次レポートメール)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Push (VAPID鍵ペア。`npx web-push generate-vapid-keys` で生成)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron からの呼び出しを認証するための共有シークレット
CRON_SECRET=

# アプリの公開URL（招待リンク・保護者確認メール等の生成に使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000
